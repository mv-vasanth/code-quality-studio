{
  "name": "cqz-ai",
  "version": "0.1.0",
  "description": "Offline AI layer for Code Quality Zone \u2014 a ~104 MB local classifier that judges the fuzzy half of test quality (fragile selectors, test scope, assertion strength). No API key, no network at run time.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cqz-ai": "dist/cqz-ai.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./audit": "./src/auditTestCode.js",
    "./questions": "./src/questions.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "keywords": [
    "test-automation",
    "code-quality",
    "offline-ai",
    "onnx",
    "playwright"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mv-vasanth/code-quality-studio.git",
    "directory": "ai"
  },
  "homepage": "https://github.com/mv-vasanth/code-quality-studio/blob/main/ai/README.md",
  "bugs": {
    "url": "https://github.com/mv-vasanth/code-quality-studio/issues"
  }
}
