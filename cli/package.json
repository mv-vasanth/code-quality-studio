{
  "name": "cqz-audit",
  "version": "2.6.0",
  "description": "Code Quality Zone \u2014 CLI for auditing test files (Playwright, Cypress, Selenium, Appium, TOSCA and more)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mv-vasanth/code-quality-studio.git"
  },
  "homepage": "https://github.com/mv-vasanth/code-quality-studio#readme",
  "bugs": {
    "url": "https://github.com/mv-vasanth/code-quality-studio/issues"
  },
  "type": "module",
  "bin": {
    "cqz": "dist/cqz.js",
    "cqz-mcp": "dist/cqz-mcp.js",
    "cqs": "dist/cqz.js",
    "cqs-mcp": "dist/cqz-mcp.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:mcp": "node build-mcp.mjs",
    "build:all": "node build.mjs && node build-mcp.mjs",
    "dev": "node bin/cqs.entry.js",
    "build:binary": "node build-binary.mjs"
  },
  "keywords": [
    "playwright",
    "cypress",
    "selenium",
    "test-quality",
    "code-quality",
    "lint",
    "cli",
    "mcp"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "docs/",
    "dist/cqz.js",
    "dist/cqz-mcp.js"
  ],
  "author": "Code Quality Zone",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "esbuild": "^0.21.5",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1"
  }
}
